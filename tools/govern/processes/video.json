{
  "version": 1,
  "name": "video",
  "description": "a video, idea to published (exit conditions from the workspace's workflow document)",
  "manual": "video/MANUAL.md",
  "prompts": "video/prompts",
  "setup": [
    { "files": { "approval": "APPROVAL.md", "sheet": "**/*sheet*.png" } },
    { "ifFile": "film.json", "commands": { "fb": ["{python}", "{paths.filmBuild}", "film.json"] }, "files": { "timings": "timings.json" } }
  ],
  "kinds": ["long", "short"],
  "exitFrom": "workflow",
  "stages": [
    { "name": "plan" }, { "name": "script" }, { "name": "script-check" }, { "name": "sound" },
    { "name": "preview" }, { "name": "produce" }, { "name": "final" }, { "name": "deliver" }
  ],
  "gates": [
    { "name": "script", "stage": "script-check" },
    { "name": "final", "stage": "final", "needs": ["script"], "message": "no script approval recorded yet" },
    { "name": "publish", "stage": "deliver", "needs": ["final"], "message": "no final-cut approval recorded yet" }
  ]
}
