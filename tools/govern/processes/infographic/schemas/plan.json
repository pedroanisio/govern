{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govern.local/infographic/plan/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "centralMessage",
    "conclusion",
    "grammar",
    "readingOrder",
    "originality",
    "effects",
    "sources",
    "claims"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "centralMessage": {
      "type": "string",
      "minLength": 1,
      "maxLength": 700
    },
    "conclusion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 700
    },
    "grammar": {
      "type": "string",
      "enum": [
        "diagram",
        "map",
        "timeline",
        "comparison",
        "chart",
        "illustration",
        "mixed"
      ]
    },
    "readingOrder": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 250
      }
    },
    "originality": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1800
    },
    "effects": {
      "type": "array",
      "minItems": 0,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "effect",
          "purpose"
        ],
        "properties": {
          "effect": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "purpose": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "locator",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "status",
          "sources",
          "locator",
          "caveat"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "status": {
            "type": "string",
            "enum": [
              "observation",
              "hypothesis",
              "simulation",
              "inference",
              "operator"
            ]
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "locator": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "caveat": {
            "type": "string",
            "maxLength": 1600
          }
        }
      }
    }
  }
}
