{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://govern.local/infographic/candidate/1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "revision",
    "width",
    "height",
    "engine",
    "sdk",
    "files",
    "candidateSha256",
    "authored"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "width": {
      "type": "integer"
    },
    "height": {
      "type": "integer"
    },
    "engine": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "sdk": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "candidateSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "authored": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  }
}
