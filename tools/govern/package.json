{
  "name": "govern",
  "private": true,
  "type": "module",
  "description": "govern CLI: run by Node type stripping, type-checked by tsc (devDependencies only)",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "coverage": "node --disable-warning=ExperimentalWarning scripts/coverage.ts",
    "test": "node --disable-warning=ExperimentalWarning --test 'test/*.test.ts'",
    "package": "node --disable-warning=ExperimentalWarning scripts/package.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.0",
    "typescript": "7.0.2"
  },
  "version": "0.3.24",
  "engines": {
    "node": ">=24"
  }
}
