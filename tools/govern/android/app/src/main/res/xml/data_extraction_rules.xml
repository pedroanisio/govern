<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the device: the token is useless without this device's Keystore anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
