#!/usr/bin/env sh
# MANPAGE >>>
# NAME
#     govern — run lanes of agent work (videos, software, ops, any process) through checked stages, with few tokens
# SYNOPSIS
#     govern version [--json]  |  govern --version [--json]
#     govern conversation create ID [--profile P | --adapter A] [--lane SLUG] [--title T] [--timeout S] [--max-context-chars N]
#     govern conversation list | show ID | history ID | close ID
#     govern conversation send ID (--message TEXT | --message-file FILE) [--request-id KEY] [--mode queue|interrupt] [--estimate-usd N] [--run [--bg]]
#     govern conversation run ID [--bg] [--once] | cancel ID RUN-ID [--reason TEXT]
#     govern conversation recover ID --action continue|retry|cancel --note TEXT
#     govern conversation context ID --summary TEXT --through MESSAGE-ID | events ID [--after N] [--follow [--timeout S]]
#     govern init [DIR] [--nested]
#     govern new SLUG (--process NAME | --kind long|short|ops) [--title T] [--lang L] [--parent SLUG] [--pin]
#     govern work SLUG STAGE [--engine claude|codex|grok] [--open]  |  brief SLUG  |  status [SLUG]
#     govern note SLUG TEXT  |  approve SLUG GATE --quote "owner's words"  |  done SLUG [--engine E]
#     govern cmd SLUG [NAME [--timeout S] [--resource R] -- ARGV...] | --rm NAME  |  file SLUG [NAME PATH-OR-GLOB]
#     govern data SLUG [--set JSON]  |  human SLUG [list|claim|delegate|complete STAGE] [--as PERSON] [--to PERSON] [--quote Q]
#     govern human-inbox [--as PERSON]
#     govern reject SLUG GATE --quote Q [--by PERSON]
#     govern event SLUG NAME --id ID --correlation JSON [--data JSON] [--generation N]
#     govern event-listen [--port 5001]  |  tick [SLUG] [--advance] [--loop --interval S]
#     govern alerts SLUG [--ack ID]  |  subprocess SLUG STAGE  |  recover SLUG --action retry|compensated --quote Q
#     govern bpmn PROCESS|SLUG [--svg FILE] [--scene FILE] [--png FILE] [--width N --height N] [--static]
#     govern process list|show NAME  |  process pin SLUG  |  process migrate SLUG --map JSON --quote Q  |  check SLUG [--set CMD --stage S]  |  check SLUG STAGE --accept --quote Q
#     govern advance SLUG [--stage STAGE] [--note EVIDENCE]  |  dep SLUG [--after LANE[:STAGE]] [--rm LANE]  |  hook stop
#     govern run SLUG CMD [--bg] [--on RESOURCE [--override-resource]] [--estimate HOURS] [-- ARGS]  |  allow NAME --extra N --quote "…" [--by OWNER]  |  resources [NAME]  |  wait SLUG [JOB] [--timeout S]  |  jobs SLUG  |  kill SLUG [JOB]
#     govern slice SLUG RECIPE [--machines N] [--estimate HOURS] [--bg]
#     govern up RESOURCE [--lane SLUG] [--count N] [--timeout S]  |  down TAG|ID [--forget] [--timeout S]  |  reap [RESOURCE] [--yes] [--timeout S]
#     govern log SLUG [JOB] [--tail N] [--grep RE]
#     govern prompts [PROCESS]  |  ask SLUG STEP [--file F]... [--var K=V]... [--image PNG]... [--effort E] [--model M]
#     govern usage [SLUG...] [--since DATE]  |  ctx  |  desk  |  tune  |  publish SLUG
#     govern artifact add SLUG FILE [--name N] [--title T] [--caption C]  |  artifact list SLUG
#     govern remote pair [--as PERSON] [--minutes N] [--url URL] [--tls-cert F] [--no-qr]  |  remote devices  |  remote revoke DEVICE
#     govern remote link [--url URL] [--tls-cert F] [--lane S] [--no-qr]  |  remote requests  |  remote refuse ID
#     govern remote confirm ID --code NNNNNN [--lane S]... [--all] [--person P]
#     govern remote serve [--host H] [--port 5002] [--tls-cert F --tls-key F]
#     govern caps [PROFILE]  |  caps --check PROFILE
#     govern decide ask --questions F (--state S | --state-file F) [--purpose P] [--json]  |  decide report
#     govern help [COMMAND]  |  COMMAND --help  |  manual [PROCESS]  |  install-skill [SKILLS-DIR] [--check]
#     govern peer id [--name N]
#     govern peer add NAME --url URL --key BASE64 [--allow NAME]... [--project SLUG|*]...
#     govern peer list
#     govern peer revoke NAME
#     govern peer serve [--port 5003] [--host 127.0.0.1]
#     govern peer push [--max N]
#     govern mesh create --name MESH --url URL --project P... [--allow NAME]... [--observer HOST]...  |  mesh invite [--host NAME] [--ttl S]
#     govern mesh join CODE --url URL --project P... [--allow NAME]... [--observer HOST]...  |  mesh sync [--url URL]  |  mesh status
#     govern mesh policy --project P... [--allow NAME]... [--observer HOST]...  |  mesh revoke HOST
#     govern center [show] [--json]  |  center serve [--port 5004] [--host 127.0.0.1] [--new-token]  |  center url [--port 5004] [--host 127.0.0.1]
#     govern agents list [--refresh]  |  agents unregister [NAME] [--as NAME]
#     govern agents register --project P... [--as NAME | --ephemeral] [--alias NAME]... [--description TEXT] [--ttl S]
#     govern task send --to codex|claude|grok|RUNNER|PROFILE|auto|owner|SESSION|NAME@PEER --project P --task T --kind K --summary S
#                      (--body B | --body-file F) [--file PATH]... [--reply-to ID] [--write | --profile P]
#                      [--lane SLUG] [--from NAME] [--estimate-usd N]
#     govern task list [--to X] [--state S] [--project P]  |  show ID  |  inbox [--as NAME] [--all] [--hook]
#     govern task close ID [--as NAME] [--note T]  |  reclaim ID --note T [--as NAME]  |  forward ID --to NAME [--as NAME]
#     govern task reply ID --kind K --summary S (--body B | --body-file F) [--as NAME]
#     govern task dispatch [--max N] [--only RUNNER] [--loop --interval S [--reap-every S]]  |  install-service [--interval S] [--reap-every S]
# DESCRIPTION
#     The control surface an AI uses while it works on a lane of work with the owner. State (stage, decisions,
#     approvals, commands, files) lives in the lane's govern.json under the workspace's projects folder, so a session starts from
#     `govern brief` (a few hundred tokens) instead of re-reading history. Builds and renders run as jobs:
#     `run --bg` returns at once and `wait` blocks with no model in the loop. `ask` runs one Codex step
#     (codex exec --json --output-schema) and verifies the reply against its schema and house rules, with
#     one repair. `usage` attributes the tokens of Claude Code, Codex and Grok sessions to (lane, stage)
#     segments opened by `govern work`, against the chat baseline the workspace config gives under "baseline".
#     The operating manual for the AI is tools/govern/SKILL.md (`govern manual`); a process may own one too (`govern manual PROCESS`).
#     A lane follows a process: a JSON file (tools/govern/processes/*.json built in: video, ops, dev; a workspace
#     adds or overrides its own in its processes folder) naming the stages, each stage's exit condition and the
#     command that checks it, and the owner's gates. `advance` moves a lane on only when the stage's check passes
#     (or, when the stage has none, with --note evidence), no gate holds the stage and no lane it waits on (`dep`)
#     is behind. `work` to a later stage holds every stage it skips to the same rules (a failing check, an open
#     gate or a pending dependency refuses it, exit 2); going back is always allowed. `dep` refuses a cycle.
#     `hook stop` is a Claude Code Stop hook: while the session's lane has a failing check it refuses
#     the stop (exit 2, the check's log as the reason), at most 3 times per work segment.
#     A .govern/ folder in the working directory or above it makes that folder a govern workspace (`govern init`
#     creates one; inside another workspace only with --nested): lanes, queue, processes, capabilities, state and
#     tuning.jsonl live inside it by convention, and an optional .govern/config.json (same keys, relative to .govern/)
#     overrides any of them. A govern.config.json there instead ({"projects", "queue", "processes"}, relative to the
#     file) names every path itself; a folder with both is refused. Either way govern runs any group of agents, itself
#     included.
#     The task queue carries messages between agents. `task send --to` accepts a runner (codex, claude, grok or one
#     named in QUEUE/config.json), a profile other than the six legacy ones (govern caps), auto, owner or the name of a
#     live Claude Code session (~/.claude/sessions); the dispatcher runs codex, claude, grok, the profiles and the
#     runners named in QUEUE/config.json ({"name", "maxRuns" (default 4 runs per thread, then BLOCKED to the owner),
#     "runners": {NAME: {"argv": [...], "format": "text"|"json-result"}}}), and the prompt goes on stdin. A
#     reply that fails verification is kept whole in QUEUE/failed/<id>.reply.txt, named in the BLOCKED notice. A
#     session is NOT woken: it reads its mail with `task inbox` (or a UserPromptSubmit hook running
#     `task inbox --hook`), answers with `reply`, and `close`s or `forward`s what is not for it. NAME defaults to
#     GOVERN_AS, else the registered session found up this process's parent chain. `task reclaim` releases an abandoned
#     claim after checking its external effects and spend, recording the required --note and notifying the owner.
#     Peer delivery uses signed HTTP behind a TLS tunnel (PEERS.md). Peer add and revoke require the owner's
#     terminal. Remote sends require a live peer and refuse --write, --profile, --lane, --estimate-usd, --file and
#     auto@PEER: the receiving host decides these. Sessions on PEER are not woken. Dispatch --loop also relays;
#     unverified output never leaves. Peer list shows grants, fingerprints, open outbound counts and last errors.
#     A mesh replaces pairwise peer setup: the registrar (mesh create) prints one single-use invite per host (mesh
#     invite); each host joins once (mesh join) and then trusts every certified member. Certificates last 30 days and
#     renew on mesh sync, which dispatch --loop runs every ten minutes. Mesh grants (--project, --allow) are this
#     host's own policy for every member. Agents register themselves (agents register) as NAME@HOST, stable or
#     ephemeral, with aliases; names and aliases are unique per host and held by the registering session, and a
#     registration grants no run. An answer to a message this host sent reaches its local author without a grant.
#     agents list shows what this host may address on every other host. Mesh create, invite, join, policy, revoke and
#     sync --url require the owner's terminal. The command center (center) shows every federated host's dispatcher,
#     queue, relay, 24 h runs and spend, agents and latest messages, with alerts; each member answers only the observers
#     its owner names (--observer; default the registrar). center serve shows it on the selected loopback host (default 127.0.0.1) behind a token kept in the private state (the address survives restarts; center url prints it).
# OPTIONS
#     --adapter A             conversation create: trusted named NDJSON adapter from conversationAdapters in workspace config
#     --max-context-chars N    conversation create: maximum assembled context characters (default 64000, at most 1000000); checkpoint rather than truncate
#     --message TEXT          conversation send: latest user message
#     --message-file FILE     conversation send: read the message from a UTF-8 file
#     --request-id KEY        conversation send: idempotent input key; conflicting content is refused
#     --mode M                conversation send: queue (default) or interrupt the active run before this follow-up
#     --run                   conversation send: execute persisted turns after submission
#     --once                  conversation run: execute at most one turn, including background execution
#     --reason TEXT           conversation cancel: explanation retained with the cancellation request
#     --through MESSAGE-ID    conversation context: completed assistant message ending the summarized context
#     --follow                conversation events: stream durable NDJSON events until --timeout (default 30 seconds)
#     Each entry names the commands that take the flag; `govern help COMMAND` shows one command's lines.
#     -h, --help              every command: after a command (`govern advance --help`), that command's lines, the same as
#                             `govern help advance`; as the first word (`govern --help`, `-h`), this manpage
#     --pin                   new: freeze the process definition even without a declared revision
#     --map JSON              process migrate: old stage names mapped to the new revision
#     --data JSON             process migrate, event: migration: converted fields (null removes); event: payload fields
#     --id ID                 event: stable delivery id used for deduplication
#     --correlation JSON      event: typed value matching the waiting stage
#     --generation N          event: activation generation, required when the event contract declares it
#     --port N                event-listen, remote serve, peer serve, center serve, center url: event-listen: loopback webhook port (default 5001);
#                             remote serve: the API port (default 5002); peer serve: 5003; center serve, center url: 5004
#     --host H                remote serve, peer serve, mesh invite, center serve, center url: default 127.0.0.1; center: loopback only; remote: another needs TLS; peer: loopback only,
#                             TLS from the tunnel; mesh invite: the name the joining host must have
#     --tls-cert F            remote pair, remote link, remote serve: the server's PEM certificate; pair, link: its pin goes
#                             into the printed link; serve: serve HTTPS (with --tls-key)
#     --tls-key F             remote serve: the PEM private key of --tls-cert
#     --minutes N             remote pair: how long the pairing code is valid (1..60, default 10)
#     --key BASE64            peer add: Ed25519 base64 DER SPKI public key
#     --allow NAME            peer add, mesh create, mesh join, mesh policy: permitted local recipient (repeatable, no wildcard)
#     --url URL               remote pair, remote link, peer add, mesh create, mesh join, mesh sync: the server's address as the
#                             phone reaches it; peer add: the peer's address; mesh: this host's public https address
#                             and drawn as a QR code the phone's camera opens in the app (link: default http://127.0.0.1:5002)
#     --no-qr                 remote pair, remote link: print the link without its QR code
#     --code NNNNNN           remote confirm: the 6-digit code the phone shows; a wrong code refuses the request for good
#     --person P              remote confirm: the person the device acts for (default owner)
#     --advance               tick: progress ready event, subprocess and retry stages through normal gates
#     --ack ID                alerts: acknowledge an alert without approving a business decision
#     --action NAME           conversation recover, recover: conversation recover: continue, retry or cancel the interrupted run;
#                             recover: retry an investigated failure or confirm compensation with compensated
#     --nested                init: make a workspace inside another workspace (refused otherwise)
#     --process P             new: the process the lane follows (govern process list)
#     --kind K                new, task send, task reply: new: the lane's kind (long|short|ops, or one the process names);
#                             task: the message kind (TASK, the default for send; ACK, REVIEW, HANDOFF, BLOCKED…)
#     --title T               conversation create, new, artifact add: conversation create: its title (default: its id); new: the
#                             lane's title (default: its slug); artifact add: the artifact's title shown to the reviewer
#     --name N                artifact add, peer id, mesh create: mesh create: the mesh's name; peer id: identity name on creation; artifact add: the artifact's name in the lane (default: the file's base name)
#     --caption C             artifact add: a caption shown with the artifact
#     --lang L                new: the lane's language, en (default) or pt-BR
#     --parent SLUG           new: the lane this one comes from (shown in its brief)
#     --engine E              work, done: claude, codex or grok (default: claude inside a Claude Code session, grok inside a
#                             grok session, else codex)
#     --open                  work: launch a fresh interactive claude, codex or grok session for this lane
#     --quote Q               approve, reject, human, allow, process migrate, check, recover: the decision owner's own words (in a Claude session,
#                             from a message the person typed; a Codex or Grok session is refused); allow: it must contain N;
#                             human: the person's instruction to claim, delegate or complete
#     --by NAME               approve, reject, allow: the decision owner, required when the gate or allowance names one other
#                             than owner; on a policy gate, the process person this OS account is mapped to
#     --extra N               allow: raise the allowance's limit by N for its current period
#     --timeout S             conversation create, conversation events, cmd, wait, up, down, reap: conversation create: a turn's
#                             limit (default 1800, at most 86400); conversation events: how long --follow streams (default 30);
#                             cmd: the command's foreground limit (default 1800); wait: block at most S seconds (default
#                             540), exit 124 if the job still runs; up, down, reap: the provider command's limit (default 120)
#     --rm NAME               cmd, dep: remove the named command (cmd) or the dependency on that lane (dep)
#     --resource R            cmd: the resource the command runs on (checked now), so run needs no --on
#     --set X                 data, check: data: a JSON object of case fields merged into the lane (changed data invalidates
#                             policy votes and active human task completion); check: set the lane's own exit check for
#                             --stage (ledgered; a swap is flagged)
#     --stage S               check, advance, recover: check: the stage --set applies to, or the active stage to check; advance: the
#                             active stage to move on from (a lane with parallel stages)
#     --accept                check: the owner accepts that stage's flagged check changes (with --quote)
#     --note T                conversation recover, advance, task close, task reclaim: conversation recover: why (required); advance: the evidence that a stage with no check is done (also recorded
#                             as a decision); task close: a note recorded with the close; task reclaim: what was checked
#                             before releasing an abandoned claim
#     --after X               conversation events, dep: conversation events: N, the event number to read after (default 0);
#                             dep: LANE[:STAGE], the lane this one waits on (all of it, or past STAGE)
#     --bg                    conversation send, conversation run, run, slice: run detached and print the job id; wait with `govern wait`
#     --on R                  run: run the command on a declared resource (locked unless it says lock: false)
#     --override-resource     run: let --on move a command off its own resource (recorded in the job)
#     --estimate HOURS        run, slice: the time reserved on the resource's allowance; the job is stopped at it
#     --machines N            slice: how many machines the recipe starts (refused above the resource's maxMachines)
#     --lane SLUG             conversation create, up, task send, remote confirm, remote link: conversation create: the lane it
#                             runs in (in that lane's folder); up: the lane the machines are booked to (default: the job it runs
#                             inside); task send: the lane whose gate authorises a spend, publish or push profile; remote confirm
#                             (repeatable), remote link: a lane the device may reach
#     --count N               up: how many instances to start (default 1)
#     --forget                down: book the machine time without running stop, for a machine that is already gone
#     --yes                   reap: run stop on the instances found and ledger the reap (default: list only)
#     --tail N                log: the last N lines (default 40)
#     --grep RE               log: only the lines matching RE
#     --file F                ask, task send: a file for the step or the message (repeatable)
#     --var K=V               ask: a prompt variable (repeatable)
#     --image PNG             ask: an image for the step (repeatable)
#     --effort E              ask: low, medium or high
#     --model M               ask: the Codex model
#     --since DATE            usage: count only work segments and machine time from YYYY-MM-DD on
#     --check                 install-skill, caps: install-skill: install nothing, exit 1 when the installed SKILL.md is
#                             missing or differs; caps: self-test a profile's grants in a sealed session
#     --to X                  human, task send, task list, task forward: human delegate: the person the task goes to; send:
#                             codex, claude, grok, a queue config runner, a profile, auto, owner or a live session; list: only messages to X; forward:
#                             the new recipient
#     --project P             task send, task list, peer add, mesh create, mesh join, mesh policy, agents register: peer add, mesh,
#                             agents register: allowed project (repeatable, * alone for any); the message's project; list: only that project's messages
#     --task T                task send: the task the message belongs to
#     --summary S             conversation context, task send, task reply: conversation context: the checkpoint summary
#                             (required, with --through); task: the one-line summary
#     --body B                task send, task reply: the message text
#     --body-file F           task send, task reply: read the message text from F
#     --reply-to ID           task send: the message this one answers
#     --from NAME             task send: local sender without @ (default: the registered session up the parent chain); only receive() files a remote sender
#     --write                 task send: let the runner change files in the project folder (default: read-only)
#     --profile P             conversation create, task send: seal the run to profile P's capabilities (govern caps); conversation
#                             create: default codex-read unless --adapter is given; task send: not with --write
#     --estimate-usd N        conversation send, task send: what the run is expected to cost, reserved against a matching allowance
#     --state S               decide ask, task list: decide ask: the state Jev is asked about, as text; task list: only
#                             messages in state open, claimed, done or failed
#     --state-file F          decide ask: read the state from F
#     --questions F           decide ask: the JSON file of typed questions (choice, score, noul)
#     --purpose P             decide ask: the name the decision is recorded under (default ask)
#     --json                  version, decide ask, center show: print the version, the whole decision, or the command center
#                             view, as JSON
#     --observer HOST         mesh create, mesh join, mesh policy: a member that may read this host's telemetry (repeatable;
#                             default: the registrar)
#     --ttl S                 mesh invite, agents register: seconds the invite or registration lasts (invite 3600 default,
#                             60..604800; stable agent 43200 default, at most 604800; ephemeral 3600, at most 86400)
#     --ephemeral             agents register: generate a short-lived e-XXXXXXXX name that ends with this session
#     --alias NAME            agents register: another name this agent answers to on this host (repeatable)
#     --description TEXT      agents register: one line other hosts see in agents list
#     --new-token             center serve: replace the kept access token with a new one (the old address stops working)
#     --refresh               agents list: ask every other host now instead of reading the last discovery
#     --as NAME               human-inbox, human, task inbox, task close, task reclaim, task forward, task reply, remote pair, agents register, agents unregister: who you are;
#                             agents: must be this session's own name;
#                             human, human-inbox: a process person, refused unless this OS account is mapped to it; task:
#                             default GOVERN_AS, else this session; remote pair: the person the device approves as (owner)
#     --all                   task inbox, remote confirm: task inbox: messages in every state, not only open ones; remote
#                             confirm: grant the device every lane. With no requested lanes, choose --lane SLUG
#                             (repeatable) or --all; confirmation never grants every lane implicitly
#     --hook                  task inbox: the UserPromptSubmit hook form, silent when empty
#     --max N                 task dispatch, peer push: run at most N messages
#     --only E                task dispatch: only messages to that runner (codex, claude, grok or a queue config runner)
#     --loop                  tick, task dispatch: keep dispatching every --interval seconds
#     --interval S            tick, task dispatch, task install-service: seconds between rounds (default 30)
#     --reap-every S          task dispatch, task install-service: list each resource's tagged instances every S seconds
#                             into state for the desk (off by default; never stops a machine)
#     --svg FILE              bpmn: write the SVG diagram there (with no --svg, --scene or --png it goes to stdout)
#     --scene FILE            bpmn: write the diagram as a scene-render scene
#     --png FILE              bpmn: render the scene to a PNG with $SCENE_RENDER, else scene-render on PATH; without an engine it fails
#     --width N               bpmn: the scene and PNG width in pixels (default 3840)
#     --height N              bpmn: the scene and PNG height in pixels (default: the diagram's aspect)
#     --static                bpmn: the process as defined, without the live state of the lanes
#     A value flag takes the next word even when it starts with --, unless that word is a govern flag;
#     give such a value as --flag=VALUE. A flag the command does not declare is refused (exit 2).
# EXIT STATUS
#     0 ok · 1 a failed check (install-skill --check, a lane status or desk could not read, a failed exit check)
#     · 2 usage or state error · 3 a Codex reply failed verification · a job's exit code for run/wait · 124 wait timed out
# ENVIRONMENT
#     Workspace: GOVERN_REPO (the workspace; else the nearest .govern/ or govern.config.json above the cwd).
#     Each overrides its config key: GOVERN_PROJECTS · GOVERN_QUEUE · GOVERN_TUNING_LOG · GOVERN_PROCESSES · GOVERN_WORKFLOW
#     · GOVERN_CAPABILITIES (must exist when set) · GOVERN_STATE (locks and reap state; default .govern/state in a
#     .govern/ workspace, else govern-state beside the projects folder) · GOVERN_PROMPTS (replaces every prompts
#     folder) · GOVERN_RESOURCES, GOVERN_ALLOWANCES (a file read instead of the resources or allowances key).
#     Sessions: GOVERN_AS (session name) · GOVERN_SESSIONS_DIR (~/.claude/sessions) · GOVERN_CLAUDE_PROJECTS
#     (~/.claude/projects) · GOVERN_CODEX_SESSIONS (~/.codex/sessions) · GOVERN_CLAUDE_SETTINGS (~/.claude/settings.json,
#     read and written by tune) · GOVERN_GROK_SESSIONS (else the sessions of govern's grok home and of the user's)
#     · GOVERN_GROK_HOME (govern's private grok home; default $XDG_STATE_HOME, else ~/.local/state, /govern/grok-home)
#     · GROK_HOME (the user's grok home, where the login is read from; default ~/.grok).
#     Programs: SCENE_RENDER (the scene-render engine bpmn --png runs) · GOVERN_CODEX_BIN (codex) · GOVERN_CLAUDE_BIN (claude) · GOVERN_GROK_BIN (grok) · GOVERN_PYTHON (python3;
#     fills {python}).
#     Limits and models: GOVERN_CTX_WARN (150000) · GOVERN_TARGET_CTX (150000, tune) · GOVERN_MAX_INLINE (60000, ask)
#     · GOVERN_QUEUE_MAX_INLINE (40000) · GOVERN_QUEUE_CLAUDE_MODEL (sonnet) · GOVERN_QUEUE_CODEX_EFFORT (medium)
#     · GOVERN_CAPS_CHECK_MODEL (haiku, caps --check) · GOVERN_GROK_CHECK_MODEL (the profile's model, caps --check)
#     · GOVERN_QUEUE_GROK_MODEL (grok's default) · GOVERN_GROK_MAX_TURNS (25; grok has no dollar cap)
#     · GOVERN_QUEUE_TIMEOUT_SEC (900, one dispatched run).
#     Conversation workers: GOVERN_CONVERSATION_RUN (set by the runtime; model-origin approvals are refused).
#     Jev (decide): TYPESAFE_API_KEY (the TypeSafe key; else the config's decide.envFile) · GOVERN_JEV_MODEL (jev-latest)
#     · GOVERN_TYPESAFE_URL (https://api.typesafe.ai).
#     Webhooks: GOVERN_WEBHOOK_TOKEN (event-listen bearer token; at least 16 characters, configured securely).
#     Test and diagnostic: GOVERN_NOW (the allowances clock) · GOVERN_PROC=ps (read the process table with ps).
#     Coverage: ST_VAR (npm run coverage writes V8 profiles and coverage.json under $ST_VAR/out/govern/coverage;
#     default <repo>/var) · NODE_V8_COVERAGE (set by npm run coverage so every child node process writes its profile)
#     · SOURCE_DATE_EPOCH (npm run package: the archive's file times; default the last commit's time).
#     Set for what govern runs: GOVERN_JOB_ID, GOVERN_JOB_DIR (every job; slice and up read GOVERN_JOB_DIR to find the
#     job they run in) · GOVERN_TAG, GOVERN_LANE, GOVERN_RESOURCE, GOVERN_COUNT, GOVERN_ID (a resource's up, down and
#     list commands) · GOVERN_PIECES, GOVERN_OUT, GOVERN_TAG, GOVERN_PIECE, GOVERN_ID (a slice recipe's steps)
#     · GOVERN_REPLY_FILE (a reply check). task install-service writes PATH, GOVERN_REPO and GOVERN_QUEUE into
#     the unit, and GOVERN_STATE and GOVERN_PROJECTS when they are set; a queued run drops CLAUDECODE and the other
#     CLAUDE_CODE_ variables. A sealed grok run (a queued one, or a conversation worker on grok) gets HOME (a private
#     empty folder), GROK_HOME (govern's private grok home), GROK_MEMORY=0 and
#     GROK_(CLAUDE|CURSOR)_(AGENTS|HOOKS|MCPS|RULES|SKILLS)_ENABLED=0, and loses GROK_CONFIG, GROK_CONFIG_PATH, GROK_AGENT
#     and GROK_SESSION_ID. ps (GOVERN_PROC=ps) runs with LC_ALL=C and TZ=UTC so its start times parse the same everywhere.
#     Read from Claude Code and Codex: CLAUDE_CODE_SESSION_ID (the session work, done, ctx and approve act for)
#     · CLAUDE_CODE_AUTO_COMPACT_WINDOW (the compact window; tune reads and sets it in the Claude settings file) · CLAUDECODE, CLAUDE_CODE_ENTRYPOINT
#     (mark a Claude session) · CODEX_THREAD_ID, CODEX_SESSION_ID, CODEX_SANDBOX, CODEX_SANDBOX_NETWORK_DISABLED (mark a
#     Codex session, whose approve and allow are refused) · GROK_AGENT, GROK_SESSION_ID (mark a grok session, whose
#     approve is refused; a grok process among the callers refuses it too).
# FILES
#     .govern/                a workspace by the convention (govern init); the folder holding it is the workspace root
#     .govern/config.json     optional: the govern.config.json keys, relative to .govern/, overriding the defaults below
#     .govern/projects/       the lanes, a folder each with its govern.json and ledger
#     .govern/queue/          the task queue; its QUEUE/config.json names runners, maxRuns and reply checks
#     .govern/processes/      the workspace's own process files (one with a built-in's name overrides it)
#     .govern/capabilities/   the workspace's capabilities and profiles
#     .govern/state/          run state: locks, instances, reservations, conversations (GOVERN_STATE)
#     .govern/tuning.jsonl    the log tune appends to
#     .govern/.gitignore      written by init: keeps state/ and projects/**/govern/jobs/ out of git
#     govern.config.json      the other workspace form: names every path itself, relative to the file
# EXAMPLES
#     govern work a-millionth-apart/shorts script
#     govern run golden-pixel fb gates sheets --bg && govern wait golden-pixel
#     govern ask you-vs-the-sun metadata --file publication.txt --file timings.json
#     govern usage --since 2026-10-12
#     govern decide ask --questions q.json --state-file task.txt   # Jev (TypeSafe System One); logs to the queue's decisions.jsonl
#     govern new ops/govern --process dev && govern cmd ops/govern test -- node --test 'tools/govern/test/*.test.ts'
#     govern advance --help                # advance's usage and flags
#     govern advance ops/govern            # runs the test check; moves to review only when it passes
# KEYWORDS
#     lanes process workflow video codex claude grok tokens usage orchestration pals-notes youtube
# SEE ALSO
#     st-man - tools/govern/SKILL.md (govern manual) - tools/govern/processes/video/MANUAL.md (govern manual video)
#     - tools/govern/BUSINESS.md - tools/govern/PURPOSE.md - tools/govern/CONVERSATIONS.md - tools/govern/REMOTE.md - tools/govern/PEERS.md
# MANPAGE <<<
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
# Only a leading -h/--help is the manpage: after the command, --help is that command's help (govern.ts), and a
# --help inside a value or after `--` belongs to the argv it is in.
case "${1-}" in
  -h|--help)
    if [ -x "$ROOT/bin/st-man" ]; then exec "$ROOT/bin/st-man" govern; fi
    exec node --disable-warning=ExperimentalWarning "$ROOT/tools/govern/govern.ts" help
    ;;
esac
exec node --disable-warning=ExperimentalWarning "$ROOT/tools/govern/govern.ts" "$@"
