#!/usr/bin/env sh
# MANPAGE >>>
# NAME
#     govern — run lanes of agent work (videos, software, ops, any process) through checked stages, with few tokens
# NEEDS
#     binary: Node 24+; configured harnesses for agent commands; credential: harness credentials for agent commands; service: none for lanes; configured services for integrations.
# SYNOPSIS
#     govern version [--json]  |  govern --version [--json]
#     govern init [DIR] [--nested]
#     govern new SLUG (--process NAME | --kind long|short|ops) [--title T] [--lang L] [--parent SLUG] [--pin]
#     govern work SLUG STAGE [--engine claude|codex|grok] [--open]  |  brief SLUG  |  status [SLUG]
#     govern note SLUG TEXT  |  approve SLUG GATE --quote "owner's words"  |  done SLUG [--engine E]
#     govern freeze SLUG --quote "owner's words" [--continued-as TEXT]  |  unfreeze SLUG --quote "owner's words"
#     govern export SLUG [--template] [--out FILE] [--exclude GLOB]... [--freeze --quote "owner's words"]
#     govern import BUNDLE [--as SLUG] [--drop-deps]  |  clone SLUG --as NEW [--template] [--exclude GLOB]...
#     govern cmd SLUG [NAME [--timeout S] [--resource R] -- ARGV...] | --rm NAME  |  file SLUG [NAME PATH-OR-GLOB]
#     govern bpmn PROCESS|SLUG [--svg FILE] [--scene FILE] [--png FILE] [--width N --height N] [--static]
#     govern process list|show NAME  |  process pin SLUG  |  process migrate SLUG --map JSON --quote Q  |  check SLUG [--set CMD --stage S]  |  check SLUG STAGE --accept --quote Q  |  check SLUG --accept-import --quote Q
#     govern advance SLUG [--stage STAGE] [--note EVIDENCE]  |  dep SLUG [--after LANE[:STAGE]] [--rm LANE]  |  hook stop|session-start|session-end
#     govern run SLUG CMD [--bg] [--on RESOURCE [--override-resource]] [--estimate HOURS] [-- ARGS]  |  allow NAME --extra N --quote "…" [--by OWNER]  |  resources [NAME]  |  wait SLUG [JOB] [--timeout S]  |  jobs SLUG  |  kill SLUG [JOB]
#     govern slice SLUG RECIPE [--machines N] [--estimate HOURS] [--bg]
#     govern up RESOURCE [--lane SLUG] [--count N] [--timeout S]  |  down TAG|ID [--forget] [--timeout S]  |  reap [RESOURCE] [--yes] [--timeout S]
#     govern log SLUG [JOB] [--tail N] [--grep RE]
#     govern ledger verify [SLUG...] [--against DIR]  |  ledger export --to DIR [SLUG...]
#     govern prompts [PROCESS]  |  ask SLUG STEP [--file F]... [--var K=V]... [--image PNG]... [--effort E] [--model M]
#     govern usage [SLUG...] [--since DATE]  |  ctx  |  desk  |  tune  |  publish SLUG
#     govern artifact add SLUG FILE [--name N] [--title T] [--caption C]  |  artifact list SLUG
#     govern caps [PROFILE]  |  caps --check PROFILE  |  caps --check --all
#     govern help [COMMAND]  |  help --topics  |  COMMAND --help  |  manual [PROCESS | --full | --size]  |  install-skill [SKILLS-DIR] [--check] [--replace]
#     govern ext list  |  ext enable NAME  |  ext disable NAME
#     govern task send --to codex|claude|grok|RUNNER|PROFILE|auto|owner|SESSION|NAME@PEER --project P --task T --kind K --summary S
#                      (--body B | --body-file F) [--file PATH]... [--reply-to ID] [--write | --profile P | --read-only]
#                      [--lane SLUG] [--from NAME] [--estimate-usd N] [--timeout S] [--check NAME]... [--verify -- ARGV...]
#     govern task list [--to X] [--state S] [--project P]  |  show ID  |  inbox [--as NAME] [--all] [--hook]
#     govern task triage [--all] [--project P] [--to X] [--json]  |  retry ID --note T [--to X] [--write | --profile P] [--timeout S]
#     govern task close ID [--as NAME] [--note T]  |  reclaim ID --note T [--as NAME]  |  forward ID --to NAME [--as NAME]
#     govern task reply ID --kind K --summary S (--body B | --body-file F) [--as NAME]
#     govern task dispatch [--max N] [--only RUNNER] [--parallel N] [--loop --interval S [--reap-every S]]
#     govern task install-service [--interval S] [--reap-every S] [--parallel N] [--system [--write]]
# DESCRIPTION
#     The control surface an AI uses while it works on a lane of work with the owner. State (stage, decisions,
#     approvals, commands, files) lives in the lane's govern.json under the workspace's projects folder, so a session starts from
#     `govern brief` (a few hundred tokens) instead of re-reading history. Builds and renders run as jobs:
#     `run --bg` returns at once and `wait` blocks with no model in the loop. `ask` runs one Codex step
#     (codex exec --json --output-schema) and verifies the reply against its schema and house rules, with
#     one repair. `usage` attributes the tokens of Claude Code, Codex and Grok sessions to (lane, stage)
#     segments opened by `govern work` or the SessionStart hook, against the chat baseline the workspace config gives under
#     "baseline". A call outside any segment is attributed in this order, first match wins: GOVERN_LANE recorded for its
#     session, the session's working directory (a lane's folder or below, or a folder it names under {repo}), a queue
#     run's project; it shows as an `unsegmented · by cwd|by GOVERN_LANE|by queue` row, counted in the lane's TOTAL and
#     never twice. With no SLUG, `usage` ends with UNATTRIBUTED: today's sessions that map to no lane (folder, tokens)
#     and lanes with a job, note or ask in the last 24 h and no session. The desk's TOKENS TODAY includes those chat
#     sessions, marks a row `(partly unsegmented)`, and has the same UNATTRIBUTED section.
#     The operating manual for the AI is the short core tools/govern/SKILL.md (`govern manual`); the detailed rules are in
#     tools/govern/REFERENCE.md (`govern manual --full`) and in each command's `govern help COMMAND`; `govern help --topics` lists
#     the reference documents. `govern install-skill [SKILLS-DIR]` makes SKILLS-DIR/govern (default .claude/skills) a symbolic
#     link to the tracked tools/govern folder, never a copy; a link already there is left alone, a link elsewhere is replaced,
#     a real directory or file is refused unless --replace. A process may own a manual too (`govern manual PROCESS`).
#     The subsystems a workspace may not need are extensions (EXTENSIONS below): they load only when the workspace enables them,
#     `govern help` lists the core commands and one line naming each extension and its state, and `govern help COMMAND` for an
#     enabled extension's command adds that extension's own manpage text (SYNOPSIS, OPTIONS, ENVIRONMENT). `desk` and `status` never
#     load a disabled extension.
#     A lane follows a process: a JSON file (tools/govern/processes/*.json built in: video, ops, dev; a workspace
#     adds or overrides its own in its processes folder) naming the stages, each stage's exit condition and the
#     command that checks it, and the owner's gates. `advance` moves a lane on only when the stage's check passes
#     (or, when the stage has none, with --note evidence), no gate holds the stage and no lane it waits on (`dep`)
#     is behind. `work` to a later stage holds every stage it skips to the same rules (a failing check, an open
#     gate or a pending dependency refuses it, exit 4); going back is always allowed. `dep` refuses a cycle.
#     `hook stop` is a Claude Code Stop hook: while the session's lane has a failing check it refuses
#     the stop ({"decision":"block","reason":...} on stdout, exit 0, the check's log as the reason), at most 3 times per work segment;
#     it closes nothing (Stop fires after every response). `hook session-end` is the SessionEnd hook: it closes the
#     work segment the SessionStart hook opened for the session (a `done` entry with closedBy "hook"), leaves one opened
#     by `work` alone, prints nothing and always exits 0. `hook session-start` is a Claude Code
#     SessionStart hook (`install-skill` prints the line to add): a session working in a lane's folder (or below it,
#     or in a folder the lane's govern.json names under {repo}), or started with GOVERN_LANE=SLUG, gets a work
#     segment on the lane's current stage (ledger `work` entry with openedBy "hook"), one line names it, and it
#     prints nothing and exits 0 when no lane matches; a second call changes nothing.
#     A .govern/ folder in the working directory or above it makes that folder a govern workspace (`govern init`
#     creates one; inside another workspace only with --nested): lanes, queue, processes, capabilities, state and
#     tuning.jsonl live inside it by convention, and an optional .govern/config.json (same keys, relative to .govern/)
#     overrides any of them. A govern.config.json there instead ({"projects", "queue", "processes"}, relative to the
#     file) names every path itself; a folder with both is refused. Either way govern runs any group of agents, itself
#     included.
#     The task queue carries messages between agents. `task send --to` accepts a runner (codex, claude, grok or one
#     named in QUEUE/config.json), a profile other than the six legacy ones (govern caps), auto, owner or the name of a
#     live Claude Code session (~/.claude/sessions); the dispatcher runs codex, claude, grok, the profiles and the
#     runners named in QUEUE/config.json ({"name", "maxRuns" (default 4 runs per thread, then BLOCKED to the owner),
#     "runners": {NAME: {"argv": [...], "format": "text"|"json-result"}}}), and the prompt goes on stdin. A
#     reply that fails verification is kept whole in QUEUE/failed/<id>.reply.txt, named in the BLOCKED notice. A
#     session is NOT woken: it reads its mail with `task inbox` (or a UserPromptSubmit hook running
#     `task inbox --hook`), answers with `reply`, and `close`s or `forward`s what is not for it. NAME defaults to
#     GOVERN_AS, else the registered session found up this process's parent chain. `task reclaim` releases an abandoned
#     claim after checking its external effects and spend, recording the required --note and notifying the sender.
#     `task triage` lists the messages in failed/ (with --all, replies marked unverified in done/), newest first, with
#     the cause, tokens, cost and the kept reply; `task retry ID --note T` files a new open message from a failed or
#     closed one (same recipient, project, task, kind, summary, body and files, threaded to it, the note on both).
#     It is never automatic and a third retry of one original is refused. QUEUE/config.json also takes "concurrency"
#     ({RUNNER-OR-PROFILE: N}: the most runs at once across all dispatchers, from live claims; default 1 per runner;
#     a message over it stays open) and "maxTimeoutSec" (default 7200). `task dispatch --parallel N` runs up to N
#     messages at once. `task send --timeout S` sets one run's limit instead of GOVERN_QUEUE_TIMEOUT_SEC; above
#     maxTimeoutSec it is refused. `status`, `desk` and `brief` warn when a lane has 20 or more jobs, notes and asks
#     since its last advance and none in 24 h; a finished lane shows `finished`.
#     Every dispatch tick fails holderless claims after twice the task's limit (GOVERN_QUEUE_TIMEOUT_SEC, or its
#     --timeout; at least one hour), never retrying unknown effects. It expires local mail after mailTtlHours (default 72) only for recipients with no
#     runner/profile, live registration/alias, live session or mailbox; owner and config mailboxes always stay open.
#     Remote mail belongs to the relay. Expiry records closedBy=govern and a reason, visible in the center, and sends
#     a NOTICE only to a known sender. Claude receives --json-schema and returns structured_output; parseReply still
#     validates every envelope, and malformed replies are kept whole without coercion.
#     A run that exits 0 with text that does not parse gets ONE repair call before it fails: the same engine and profile
#     sealed to `read` only, its cheapest model (Claude haiku, at most 0.25 USD; Codex low effort), 120 s, the raw text
#     in the prompt, "nothing added, nothing removed"; the repaired reply must keep the original's words and goes
#     through parseReply and the content checks. The result, the ledger and `task show` record it ("envelope repaired
#     by one <engine> call"; `task list` shows [repaired]); a repair that fails keeps QUEUE/failed/<id>.reply.txt and
#     .repair.txt. A run that failed otherwise (nonzero exit, timeout, is_error) is never repaired.
#     Reply checks: HANDOFF replies are checked by default (every commit they name must exist in the project's git
#     repository; a reply naming none stays [shape only]). `task send --check NAME` adds a check, resolved from the
#     profile's capabilities file `checks`, QUEUE/config.json `checks.named`, then the built-ins (file-refs,
#     commit-refs, claims-cited: every id of the --file ledger {"claims": [{"id": ...}]} must appear in the reply);
#     an unknown NAME is refused (exit 4). `task send --verify -- ARGV...` has govern run ARGV (no shell, 600 s, in the
#     project folder) after the other checks: [checked: verify (exit 0)] only on exit 0, else [unverified] with the
#     exit code and the last 12 lines under QUEUE/replychecks/. `desk` counts the day's replies: checked, shape only,
#     unverified, repaired.
#     No profile runs unchecked: for a message whose profile has no passing self-test of its current definition the dispatcher runs `caps --check`
#     itself, once per profile hash; a failed check holds the message (open) and sends the sender one BLOCKED notice, and later messages on
#     that hash are refused until `caps --check P` passes. A codex run gets a private CODEX_HOME (GOVERN_CODEX_HOME, default the state
#     folder's codex-home): the login and a minimal config.toml, not ~/.codex. `task send` refuses (exit 4) a message to a profile that cannot write
#     whose summary or body asks for file changes (an edit verb within six words of file, test, module, function, branch, commit, .ts, .py or .md);
#     --write or --profile P with a write profile fixes it, --read-only sends it and records readOnlyConfirmed. `task show` and `desk` print
#     `bound: N turns · T s` for a running or recorded grok run: grok has no dollar cap, so that is its only limit.
#     Standard host setup includes task install-service and its printed enable command. --system previews a system
#     unit with current User=; --system --write requires root, otherwise prints the refusal and unit, never escalates.
# OPTIONS
#     Each entry names the commands that take the flag; `govern help COMMAND` shows one command's lines.
#     -h, --help              every command: after a command (`govern advance --help`), that command's lines, the same as
#                             `govern help advance`; as the first word (`govern --help`, `-h`), this manpage
#     --pin                   new: freeze the process definition even without a declared revision
#     --map JSON              process migrate: old stage names mapped to the new revision
#     --data JSON             process migrate: converted fields (null removes)
#     --nested                init: make a workspace inside another workspace (refused otherwise)
#     --full                  manual: the core manual followed by REFERENCE.md
#     --replace               install-skill: remove a real directory or file at SKILLS-DIR/govern and link it (otherwise refused)
#     --size                  manual: the bytes and approximate tokens (bytes / 3.6) of SKILL.md and REFERENCE.md, and a third line for the
#                             documents of the enabled extensions
#     --topics                help: the reference documents, one line each, with their paths; an extension's documents only while it is enabled
#     --process P             new: the process the lane follows (govern process list)
#     --kind K                new, task send, task reply: new: the lane's kind (long|short|ops, or one the process names);
#                             task: the message kind (TASK, the default for send; ACK, REVIEW, HANDOFF, BLOCKED…)
#     --title T               new, artifact add: new: the lane's title (default: its slug); artifact add: the artifact's title shown to the reviewer
#     --name N                artifact add: the artifact's name in the lane (default: the file's base name)
#     --caption C             artifact add: a caption shown with the artifact
#     --lang L                new: the lane's language, en (default) or pt-BR
#     --parent SLUG           new: the lane this one comes from (shown in its brief)
#     --engine E              work, done: claude, codex or grok (default: claude inside a Claude Code session, grok inside a
#                             grok session, else codex)
#     --open                  work: launch a fresh interactive claude, codex or grok session for this lane
#     --quote Q               approve, allow, process migrate, check, freeze, unfreeze, export: the decision owner's own words (in
#                             a Claude session, from a message the person typed; a Codex or Grok session is refused); allow: it must contain N
#     --continued-as TEXT     freeze: a free-text pointer to where the work continued (e.g. workspace-b:ops/new-slug); on
#                             an already-frozen lane this is the only thing a further freeze call records
#     --template              export, clone: carry the lane's configuration only (no files, data, notes, approvals, ledger or conversations)
#     --freeze                export: freeze the lane first, inside the same lock, exactly as govern freeze does
#     --out FILE              export: where to write the bundle (default: a name derived from the slug)
#     --exclude GLOB          export, clone: skip matching paths (repeatable), needed for a directory holding .git
#     --drop-deps             import: drop a dependency (--after) on a lane this workspace does not have, instead of refusing
#     --by NAME               approve, allow: the decision owner, required when the gate or allowance names one other
#                             than owner; on a policy gate, the process person this OS account is mapped to
#     --extra N               allow: raise the allowance's limit by N for its current period
#     --timeout S             cmd, wait, up, down, reap, task send, task retry: cmd: the command's foreground limit (default 1800); wait: block at most S seconds (default
#                             540), exit 124 if the job still runs; up, down, reap: the provider command's limit (default 120);
#                             task send, task retry: the dispatched run's limit instead of GOVERN_QUEUE_TIMEOUT_SEC, refused
#                             above maxTimeoutSec (QUEUE/config.json, default 7200)
#     --rm NAME               cmd, dep: remove the named command (cmd) or the dependency on that lane (dep)
#     --resource R            cmd: the resource the command runs on (checked now), so run needs no --on
#     --set X                 check: set the lane's own exit check for --stage (ledgered; a swap is flagged)
#     --stage S               check, advance: check: the stage --set applies to, or the active stage to check; advance: the active stage to move on from (a lane with parallel stages)
#     --accept                check: the owner accepts that stage's flagged check changes (with --quote)
#     --accept-import         check: the owner accepts an imported lane (with --quote): lifts the quarantine jobs.start
#                             holds every one of its commands under until then, and counts as --accept for every stage
#     --note T                advance, task retry, task close, task reclaim: advance: the evidence that a stage with no check is done (also recorded
#                             as a decision); task retry: what was fixed before sending again (required, recorded on both messages);
#                             task close: a note recorded with the close; task reclaim: what was checked
#                             before releasing an abandoned claim
#     --after X               dep: LANE[:STAGE], the lane this one waits on (all of it, or past STAGE)
#     --bg                    run, slice: run detached and print the job id; wait with `govern wait`
#     --on R                  run: run the command on a declared resource (locked unless it says lock: false)
#     --override-resource     run: let --on move a command off its own resource (recorded in the job)
#     --estimate HOURS        run, slice: the time reserved on the resource's allowance; the job is stopped at it
#     --machines N            slice: how many machines the recipe starts (refused above the resource's maxMachines)
#     --lane SLUG             up, task send: up: the lane the machines are booked to (default: the job it runs
#                             inside); task send: the lane whose gate authorises a spend, publish or push profile
#     --count N               up: how many instances to start (default 1)
#     --forget                down: book the machine time without running stop, for a machine that is already gone
#     --yes                   reap: run stop on the instances found and ledger the reap (default: list only)
#     --tail N                log: the last N lines (default 40)
#     --grep RE               log: only the lines matching RE
#     --file F                ask, task send: a file for the step or the message (repeatable)
#     --var K=V               ask: a prompt variable (repeatable)
#     --image PNG             ask: an image for the step (repeatable)
#     --effort E              ask: low, medium or high
#     --model M               ask: the Codex model
#     --since DATE            usage: count only work segments and machine time from YYYY-MM-DD on
#     --check                 install-skill, caps, task send: install-skill: install nothing, exit 1 when SKILLS-DIR/govern is
#                             missing, a copy, a link elsewhere or has a stale SKILL.md; caps: self-test a profile's grants in a
#                             sealed session (--all: every profile without a current passing check); task send: NAME, a content check on the reply (repeatable; file-refs, commit-refs,
#                             claims-cited, or one the profile or config.json defines)
#     --verify                task send: run the command after -- in the project folder once the reply is filed and the checks
#                             pass; the reply is [checked] only on exit 0
#     --against DIR           ledger verify: also check that each ledger still begins with the copy govern ledger export made in DIR
#     --to X                  ledger export, task send, task list, task triage, task retry, task forward: ledger export: the append-only folder; send:
#                             codex, claude, grok, a queue config runner, a profile, auto, owner, a live session or NAME@PEER; list, triage: only messages to X; retry: send to X
#                             instead of the original recipient; forward: the new recipient
#     --project P             task send, task list, task triage: the message's project; list, triage: only that project's messages
#     --task T                task send: the task the message belongs to
#     --summary S             task send, task reply: the one-line summary
#     --body B                task send, task reply: the message text
#     --body-file F           task send, task reply: read the message text from F
#     --reply-to ID           task send: the message this one answers
#     --from NAME             task send: local sender without @ (default: the registered session up the parent chain); only receive() files a remote sender
#     --write                 task send, task retry, task install-service: task send, task retry: let the runner change files in the project folder
#                             (default: read-only; retry: as the original); task install-service with --system: write only as root, otherwise print refusal and unit
#     --read-only             task send: send a message that matches the write rule to a profile that cannot write, and record readOnlyConfirmed
#     --profile P             task send, task retry: seal the run to profile P's capabilities (govern caps); not with --write
#     --estimate-usd N        task send: what the run is expected to cost, reserved against a matching allowance
#     --state S               task list: only messages in state open, claimed, done or failed
#     --json                  version, task triage: print the version, or the triage rows as an array, as JSON
#     --as NAME               import, clone, task inbox, task close, task reclaim, task forward, task reply: import: the new lane's slug (default: the
#                             source's own); clone: the new lane's slug (required); task: who you are; default GOVERN_AS, else this session
#     --all                   task triage, task inbox, caps: task triage: also replies marked unverified in done/; task inbox: messages in every state, not only open ones;
#                             caps --check: every profile without a current passing check
#     --hook                  task inbox: the UserPromptSubmit hook form, silent when empty
#     --max N                 task dispatch: run at most N messages
#     --only E                task dispatch: only messages to that runner (codex, claude, grok or a queue config runner)
#     --parallel N            task dispatch, task install-service: run up to N messages at once in this dispatcher (default 1);
#                             a runner still never exceeds its QUEUE/config.json concurrency (default 1) across all dispatchers
#     --run-claimed ID        task dispatch: run the message a --parallel dispatcher claimed (what its workers run; not for use by hand)
#     --loop                  task dispatch, drive, tick, slack notify: run again every --interval seconds
#     --system                task install-service: preview /etc/systemd/system/govern-dispatch.service with current User=
#     --interval S            task dispatch, task install-service, drive, tick, slack notify: seconds between rounds (default 30)
#     --reap-every S          task dispatch, task install-service: list each resource's tagged instances every S seconds
#                             into state for the desk (off by default; never stops a machine)
#     --svg FILE              bpmn: write the SVG diagram there (with no --svg, --scene or --png it goes to stdout)
#     --scene FILE            bpmn: write the diagram as a scene-render scene
#     --png FILE              bpmn: render the scene to a PNG with $SCENE_RENDER, else scene-render on PATH; without an engine it fails
#     --width N               bpmn: the scene and PNG width in pixels (default 3840)
#     --height N              bpmn: the scene and PNG height in pixels (default: the diagram's aspect)
#     --static                bpmn: the process as defined, without the live state of the lanes
#     A value flag takes the next word even when it starts with --, unless that word is a govern flag;
#     give such a value as --flag=VALUE. A flag the command does not declare is refused (exit 2).
# EXIT STATUS
#     0 ok · 1 a failed check (install-skill --check, a lane status or desk could not read, a failed exit check)
#     · 2 usage error (unknown command or flag, a missing argument, a malformed flag value) · 3 a Codex reply failed
#     verification · 4 refused by the workspace's state (no such lane, a gate or check holds, a bad govern.json or
#     config, a disabled extension) · a job's exit code for run/wait · 124 wait timed out
# ENVIRONMENT
#     Workspace: GOVERN_REPO (the workspace; else the nearest .govern/ or govern.config.json above the cwd, and below
#     GOVERN_CEILING when set: that folder and those above it are not searched).
#     Each overrides its config key: GOVERN_PROJECTS · GOVERN_QUEUE · GOVERN_TUNING_LOG · GOVERN_PROCESSES · GOVERN_WORKFLOW
#     · GOVERN_CAPABILITIES (must exist when set) · GOVERN_STATE (locks and reap state; default .govern/state in a
#     .govern/ workspace, else govern-state beside the projects folder) · GOVERN_PROMPTS (replaces every prompts
#     folder) · GOVERN_RESOURCES, GOVERN_ALLOWANCES (a file read instead of the resources or allowances key).
#     Extensions: GOVERN_EXTENSIONS (comma-separated names of the extensions to enable, instead of the config's "extensions"; empty is unset)
#     Sessions: GOVERN_AS (session name) · GOVERN_LANE (slug: attribute the session to that lane; read by hook session-start) · GOVERN_SESSIONS_DIR (~/.claude/sessions) · GOVERN_CLAUDE_PROJECTS
#     (~/.claude/projects) · GOVERN_CODEX_SESSIONS (~/.codex/sessions) · GOVERN_CLAUDE_SETTINGS (~/.claude/settings.json,
#     read and written by tune) · GOVERN_GROK_SESSIONS (else the sessions of govern's grok home and of the user's)
#     · GOVERN_GROK_HOME (govern's private grok home; default $XDG_STATE_HOME, else ~/.local/state, /govern/grok-home)
#     · GROK_HOME (the user's grok home, where the login is read from; default ~/.grok) · GOVERN_CODEX_HOME (govern's private
#     codex home; default $XDG_STATE_HOME, else ~/.local/state, /govern/codex-home) · CODEX_HOME (the user's codex home, where
#     the login is read from; default ~/.codex).
#     Programs: SCENE_RENDER (the scene-render engine bpmn --png runs) · GOVERN_CODEX_BIN (codex) · GOVERN_CLAUDE_BIN (claude) · GOVERN_GROK_BIN (grok) · GOVERN_PYTHON (python3;
#     fills {python}). SCENE_RENDER_BIN (scene-render; the engine the infographic process's pipeline.py render stage runs).
#     Limits and models: GOVERN_CTX_WARN (150000) · GOVERN_TARGET_CTX (150000, tune) · GOVERN_MAX_INLINE (60000, ask)
#     · GOVERN_QUEUE_MAX_INLINE (40000) · GOVERN_QUEUE_CLAUDE_MODEL (sonnet) · GOVERN_QUEUE_CODEX_EFFORT (medium)
#     · GOVERN_QUEUE_REPAIR (1; 0 turns off the one envelope-repair call) · GOVERN_QUEUE_REPAIR_EFFORT (low, codex repair)
#     · GOVERN_CAPS_CHECK_MODEL (haiku, caps --check) · GOVERN_GROK_CHECK_MODEL (the profile's model, caps --check)
#     · GOVERN_QUEUE_GROK_MODEL (grok's default) · GOVERN_GROK_MAX_TURNS (25; grok has no dollar cap)
#     · GOVERN_QUEUE_TIMEOUT_SEC (900, one dispatched run); a message's --timeout replaces it for that run; holderless claims fail after twice the run's limit, at least 3600 s.
#     Conversation workers: GOVERN_CONVERSATION_RUN (set by the runtime; model-origin approvals are refused).
#     Test and diagnostic: GOVERN_NOW (the allowances clock) · GOVERN_PROC=ps (read the process table with ps)
#     · NODE_TEST_CONTEXT (set by a parent node --test; plans/lane-portability/check.ts removes it from its child runs).
#     Coverage: ST_VAR (npm run coverage writes V8 profiles and coverage.json under $ST_VAR/out/govern/coverage;
#     default <repo>/var) · NODE_V8_COVERAGE (set by npm run coverage so every child node process writes its profile)
#     · SOURCE_DATE_EPOCH (npm run package: the archive's file times; default the last commit's time).
#     Set for what govern runs: GOVERN_JOB_ID, GOVERN_JOB_DIR (every job; slice and up read GOVERN_JOB_DIR to find the
#     job they run in) · GOVERN_TAG, GOVERN_LANE, GOVERN_RESOURCE, GOVERN_COUNT, GOVERN_ID (a resource's up, down and
#     list commands) · GOVERN_PIECES, GOVERN_OUT, GOVERN_TAG, GOVERN_PIECE, GOVERN_ID (a slice recipe's steps)
#     · GOVERN_OUTPUTS (a service stage's command under govern drive: the file it writes its outputs to), GOVERN_STAGE,
#     GOVERN_ROUND, GOVERN_ATTEMPT, GOVERN_IDEMPOTENCY_KEY and GOVERN_INTERRUPTED (the same command: which entry and
#     attempt it is, the key its outside effect is deduplicated by, and 1 after an interrupted attempt)
#     · GOVERN_REPLY_FILE (a reply check) · GOVERN_TASK_FILES (a reply check: the task's attached files, a JSON array of paths). task install-service writes PATH, GOVERN_REPO and GOVERN_QUEUE into
#     the unit, and GOVERN_STATE and GOVERN_PROJECTS when they are set; a queued run drops CLAUDECODE and the other
#     CLAUDE_CODE_ variables. A sealed grok run (a queued one, or a conversation worker on grok) gets HOME (a private
#     empty folder), GROK_HOME (govern's private grok home), GROK_MEMORY=0 and
#     GROK_(CLAUDE|CURSOR)_(AGENTS|HOOKS|MCPS|RULES|SKILLS)_ENABLED=0, and loses GROK_CONFIG, GROK_CONFIG_PATH, GROK_AGENT
#     and GROK_SESSION_ID. ps (GOVERN_PROC=ps) runs with LC_ALL=C and TZ=UTC so its start times parse the same everywhere.
#     Read from Claude Code and Codex: CLAUDE_CODE_SESSION_ID (the session work, done, ctx and approve act for)
#     · CLAUDE_CODE_AUTO_COMPACT_WINDOW (the compact window; tune reads and sets it in the Claude settings file) · CLAUDECODE, CLAUDE_CODE_ENTRYPOINT
#     (mark a Claude session) · CODEX_THREAD_ID, CODEX_SESSION_ID, CODEX_SANDBOX, CODEX_SANDBOX_NETWORK_DISABLED (mark a
#     Codex session, whose approve and allow are refused) · GROK_AGENT, GROK_SESSION_ID (mark a grok session, whose
#     approve is refused; a grok process among the callers refuses it too).
# FILES
#     .govern/                a workspace by the convention (govern init); the folder holding it is the workspace root
#     .govern/config.json     optional: the govern.config.json keys, relative to .govern/, overriding the defaults below
#     .govern/projects/       the lanes, a folder each with its govern.json and ledger
#     .govern/queue/          the task queue; its QUEUE/config.json names runners, maxRuns and reply checks
#     .govern/processes/      the workspace's own process files (one with a built-in's name overrides it)
#     .govern/capabilities/   the workspace's capabilities and profiles
#     .govern/state/          run state: locks, instances, reservations, conversations (GOVERN_STATE)
#     .govern/tuning.jsonl    the log tune appends to
#     .govern/.gitignore      written by init: keeps state/ and projects/**/govern/jobs/ out of git
#     govern.config.json      the other workspace form: names every path itself, relative to the file; mailboxes is a
#                             string array of durable inboxes (owner always included); mailTtlHours is a positive integer
#                             (default 72), governing old local mail to recipients with no live identity
# EXAMPLES
#     govern work a-millionth-apart/shorts script
#     govern run golden-pixel fb gates sheets --bg && govern wait golden-pixel
#     govern ask you-vs-the-sun metadata --file publication.txt --file timings.json
#     govern usage --since 2026-10-12
#     govern new ops/govern --process dev && govern cmd ops/govern test -- node --test 'tools/govern/test/*.test.ts'
#     govern advance --help                # advance's usage and flags
#     govern advance ops/govern            # runs the test check; moves to review only when it passes
# KEYWORDS
#     lanes process workflow video codex claude grok tokens usage orchestration checks approvals
# EXTENSIONS
#     Peer, mesh, agents, center, remote, decide, conversation, slack and the business event commands are extensions: a workspace enables each
#     with `govern ext enable NAME` ("extensions" in .govern/config.json, or GOVERN_EXTENSIONS), and `govern help COMMAND` prints an enabled
#     extension's own manpage text. A command of a disabled extension is refused (exit 4). `govern ext list` shows the state of each.
#     tools/govern/PEERS.md (extensions peer and center) - tools/govern/REMOTE.md (extension remote) - tools/govern/CONVERSATIONS.md (extension conversation)
#     - tools/govern/SLACK.md (extension slack)
#     - tools/govern/BUSINESS.md (extension business) - tools/govern/LIFECYCLE.md (extension business)
# SEE ALSO
#     st-man - tools/govern/SKILL.md (govern manual) - tools/govern/REFERENCE.md (govern manual --full) - tools/govern/processes/video/MANUAL.md (govern manual video)
#     - tools/govern/processes/infographic/MANUAL.md (govern manual infographic) - tools/govern/PURPOSE.md
#     - tools/govern/PORTABILITY.md
# MANPAGE <<<
set -eu
# Help stays shell-only; other commands check before loading TypeScript.
require_node() {
  NODE_VERSION=$(node --version 2>/dev/null) || NODE_VERSION='no node'
  NODE_MAJOR=${NODE_VERSION#v}
  NODE_MAJOR=${NODE_MAJOR%%.*}
  case "$NODE_MAJOR" in
    ''|*[!0-9]*) NODE_MAJOR=0 ;;
  esac
  if [ "$NODE_MAJOR" -lt 24 ]; then
    echo "govern needs Node 24 or later, found $NODE_VERSION" >&2
    exit 1
  fi
}
case "${1-}" in
  -h|--help) ;;
  *) require_node ;;
esac
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
# Only a leading -h/--help is the manpage: after the command, --help is that command's help (govern.ts), and a
# --help inside a value or after `--` belongs to the argv it is in.
case "${1-}" in
  -h|--help)
    if [ -x "$ROOT/bin/st-man" ]; then exec "$ROOT/bin/st-man" govern; fi
    require_node
    exec node --disable-warning=ExperimentalWarning "$ROOT/tools/govern/govern.ts" help
    ;;
esac
exec node --disable-warning=ExperimentalWarning "$ROOT/tools/govern/govern.ts" "$@"
